    {
      "version": "2.0.0",
      "steps": [
        {
          "template": "esrs-benchmark-configs",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-configs and copy esrs-benchmarks (1:1 rename). Source is never deleted.",
          "reindex": {
            "source": "esrs-benchmarks",
            "mode": "copy"
          }
        },
        {
          "template": "esrs-benchmark-runs",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-runs and copy run-level fields (status/config/summary/error/took) from esrs-evaluations (1:1), stripping results/runtime/unrated_docs. Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "runs"
          }
        },
        {
          "template": "esrs-benchmark-results",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-results data stream and fan out one document per (strategy_id, scenario_id) search from esrs-evaluations results[].searches[]. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "results"
          }
        },
        {
          "template": "esrs-benchmark-runtime-indices",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-runtime-indices data stream and fan out one document per index from esrs-evaluations runtime.indices. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "runtime_indices"
          }
        },
        {
          "template": "esrs-benchmark-runtime-strategies",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-runtime-strategies data stream and fan out one document per strategy from esrs-evaluations runtime.strategies. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "runtime_strategies"
          }
        },
        {
          "template": "esrs-benchmark-runtime-scenarios",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-runtime-scenarios data stream and fan out one document per scenario from esrs-evaluations runtime.scenarios. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "runtime_scenarios"
          }
        },
        {
          "template": "esrs-benchmark-runtime-judgements",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-runtime-judgements data stream and fan out one document per judgement from esrs-evaluations runtime.judgements. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "runtime_judgements"
          }
        },
        {
          "template": "esrs-benchmark-unrated-docs",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-unrated-docs data stream and fan out one document per unrated document from esrs-evaluations unrated_docs. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "unrated_docs"
          }
        },
        {
          "template": "esrs-benchmark-failures",
          "action": "reindex_and_cutover",
          "requires_reindex": true,
          "additive_reindex": true,
          "description": "Create esrs-benchmark-failures data stream and fan out one document per strategy with failures from esrs-evaluations results[].failures. No DLM retention set (infinite). Source is never deleted.",
          "reindex": {
            "source": "esrs-evaluations",
            "mode": "failures"
          }
        },
        {
          "template": "esrs-benchmark-runs",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add progress (requests_total/requests_completed/requests_succeeded/requests_failed) to mappings, so the worker can report live run progress and the UI can render a progress bar.",
          "mapping_additions": {
            "progress": {
              "properties": {
                "requests_total": {"type": "integer"},
                "requests_completed": {"type": "integer"},
                "requests_succeeded": {"type": "integer"},
                "requests_failed": {"type": "integer"}
              }
            }
          }
        },
        {
          "template": "esrs-strategies",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add hyperparameters (definitions with promoted values and valid testable values), hyperparameter_refs, and promoted_from to mappings.",
          "mapping_additions": {
            "hyperparameter_refs": {
              "type": "keyword"
            },
            "hyperparameters": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "type": {
                  "type": "keyword"
                },
                "promoted_value": {
                  "type": "object",
                  "enabled": false
                },
                "testable_values": {
                  "type": "object",
                  "enabled": false
                }
              }
            },
            "promoted_from": {
              "properties": {
                "strategy_id": {
                  "type": "keyword"
                },
                "run_id": {
                  "type": "keyword"
                },
                "variant_id": {
                  "type": "keyword"
                },
                "values": {
                  "type": "object",
                  "enabled": false
                },
                "promoted_at": {
                  "type": "date"
                }
              }
            }
          }
        },
        {
          "template": "esrs-benchmark-configs",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add task.optimization (hyperparameter search settings, objective, holdout) to mappings.",
          "mapping_additions": {
            "task": {
              "properties": {
                "optimization": {
                  "properties": {
                    "algorithm": {
                      "type": "keyword"
                    },
                    "sample_size": {
                      "type": "integer"
                    },
                    "seed": {
                      "type": "keyword"
                    },
                    "points_per_range": {
                      "type": "integer"
                    },
                    "values_to_test": {
                      "type": "object",
                      "enabled": false
                    },
                    "objective": {
                      "properties": {
                        "metric": {
                          "type": "keyword"
                        },
                        "aggregation": {
                          "type": "keyword"
                        }
                      }
                    },
                    "latency_constraint": {
                      "properties": {
                        "stat": {
                          "type": "keyword"
                        },
                        "max_ms": {
                          "type": "float"
                        }
                      }
                    },
                    "holdout": {
                      "properties": {
                        "ratio": {
                          "type": "float"
                        },
                        "seed": {
                          "type": "keyword"
                        }
                      }
                    },
                    "max_concurrent_searches": {
                      "type": "integer"
                    },
                    "store_hits_top_n": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "template": "esrs-benchmark-runs",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add task.optimization (hyperparameter search settings, objective, holdout) to mappings.",
          "mapping_additions": {
            "task": {
              "properties": {
                "optimization": {
                  "properties": {
                    "algorithm": {
                      "type": "keyword"
                    },
                    "sample_size": {
                      "type": "integer"
                    },
                    "seed": {
                      "type": "keyword"
                    },
                    "points_per_range": {
                      "type": "integer"
                    },
                    "values_to_test": {
                      "type": "object",
                      "enabled": false
                    },
                    "objective": {
                      "properties": {
                        "metric": {
                          "type": "keyword"
                        },
                        "aggregation": {
                          "type": "keyword"
                        }
                      }
                    },
                    "latency_constraint": {
                      "properties": {
                        "stat": {
                          "type": "keyword"
                        },
                        "max_ms": {
                          "type": "float"
                        }
                      }
                    },
                    "holdout": {
                      "properties": {
                        "ratio": {
                          "type": "float"
                        },
                        "seed": {
                          "type": "keyword"
                        }
                      }
                    },
                    "max_concurrent_searches": {
                      "type": "integer"
                    },
                    "store_hits_top_n": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "template": "esrs-benchmark-results",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add variant_id, split (tuning or holdout), and coverage to mappings, so results can be stored per hyperparameter variant.",
          "mapping_additions": {
            "variant_id": {
              "type": "keyword"
            },
            "split": {
              "type": "keyword"
            },
            "coverage": {
              "type": "float"
            }
          }
        },
        {
          "template": "esrs-benchmark-runtime-scenarios",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add split (tuning or holdout) to mappings.",
          "mapping_additions": {
            "split": {
              "type": "keyword"
            }
          }
        },
        {
          "template": "esrs-benchmark-runtime-strategies",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add variant_count and winner_variant_id to mappings.",
          "mapping_additions": {
            "variant_count": {
              "type": "integer"
            },
            "winner_variant_id": {
              "type": "keyword"
            }
          }
        },
        {
          "template": "esrs-benchmark-unrated-docs",
          "action": "update_template",
          "requires_reindex": false,
          "description": "Add variants to mappings, so unrated docs can be filtered to winning variants.",
          "mapping_additions": {
            "variants": {
              "type": "keyword"
            }
          }
        },
        {
          "template": "esrs-benchmark-runtime-variants",
          "action": "create_template",
          "requires_reindex": false,
          "description": "Create esrs-benchmark-runtime-variants data stream holding one document per hyperparameter variant of a run (values and aggregated scores). No DLM retention set (infinite)."
        }
      ]
    }
  ]
}
