{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Benchmark Forensics (data stream)",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-benchmark-forensics*"
  ],
  "priority": 500,
  "data_stream": {},
  "template": {
    "lifecycle": {
      "enabled": true
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "run_id": {
          "type": "keyword"
        },
        "workspace_id": {
          "type": "keyword"
        },
        "benchmark_id": {
          "type": "keyword"
        },
        "runtime": {
          "properties": {
            "indices": {
              "type": "object",
              "enabled": false
            },
            "scenarios": {
              "type": "object",
              "enabled": false
            },
            "strategies": {
              "type": "object",
              "enabled": false
            },
            "judgements": {
              "type": "object",
              "enabled": false
            }
          }
        },
        "unrated_docs": {
          "properties": {
            "_id": {
              "type": "keyword"
            },
            "_index": {
              "type": "keyword"
            },
            "count": {
              "type": "integer"
            },
            "strategies": {
              "type": "keyword"
            },
            "scenarios": {
              "type": "keyword"
            }
          }
        },
        "failures": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}
