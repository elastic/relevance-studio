{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Strategies",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-strategies*"
  ],
  "template": {
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@meta": {
          "properties": {
            "created_at": {
              "type": "date"
            },
            "created_by": {
              "type": "keyword"
            },
            "created_via": {
              "type": "keyword"
            },
            "updated_at": {
              "type": "date"
            },
            "updated_by": {
              "type": "keyword"
            },
            "updated_via": {
              "type": "keyword"
            }
          }
        },
        "workspace_id": {
          "type": "keyword"
        },
        "name": {
          "type": "keyword"
        },
        "params": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "template": {
          "properties": {
            "lang": {
              "type": "keyword"
            },
            "source": {
              "type": "text",
              "index": false
            }
          }
        },
        "_search": {
          "properties": {
            "name": {
              "type": "text"
            },
            "params": {
              "type": "text"
            },
            "tags": {
              "type": "text"
            },
            "template": {
              "properties": {
                "source": {
                  "type": "text"
                }
              }
            }
          }
        },
        "hyperparameter_refs": {
          "type": "keyword"
        },
        "hyperparameters": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "promoted_value": {
              "type": "object",
              "enabled": false
            },
            "testable_values": {
              "type": "object",
              "enabled": false
            }
          }
        },
        "promoted_from": {
          "properties": {
            "strategy_id": {
              "type": "keyword"
            },
            "run_id": {
              "type": "keyword"
            },
            "variant_id": {
              "type": "keyword"
            },
            "values": {
              "type": "object",
              "enabled": false
            },
            "promoted_at": {
              "type": "date"
            }
          }
        }
      }
    }
  }
}
