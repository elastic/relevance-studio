{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Benchmark Results (data stream)",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-benchmark-results*"
  ],
  "priority": 500,
  "data_stream": {},
  "template": {
    "lifecycle": {
      "enabled": true
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "run_id": {
          "type": "keyword"
        },
        "workspace_id": {
          "type": "keyword"
        },
        "benchmark_id": {
          "type": "keyword"
        },
        "strategy_id": {
          "type": "keyword"
        },
        "scenario_id": {
          "type": "keyword"
        },
        "metrics": {
          "properties": {
            "dcg": {
              "type": "float"
            },
            "err": {
              "type": "float"
            },
            "mrr": {
              "type": "float"
            },
            "ndcg": {
              "type": "float"
            },
            "precision": {
              "type": "float"
            },
            "recall": {
              "type": "float"
            }
          }
        },
        "took": {
          "type": "long"
        },
        "hits": {
          "properties": {
            "hit": {
              "properties": {
                "_id": {
                  "type": "keyword"
                },
                "_index": {
                  "type": "keyword"
                },
                "_score": {
                  "type": "float"
                },
                "_ignored": {
                  "type": "keyword"
                }
              }
            },
            "rating": {
              "type": "byte"
            }
          }
        },
        "variant_id": {
          "type": "keyword"
        },
        "split": {
          "type": "keyword"
        },
        "coverage": {
          "type": "float"
        }
      }
    }
  }
}
