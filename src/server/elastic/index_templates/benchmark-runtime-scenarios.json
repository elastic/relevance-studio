{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Benchmark Runtime Scenarios (data stream)",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-benchmark-runtime-scenarios*"
  ],
  "priority": 500,
  "data_stream": {},
  "template": {
    "lifecycle": {
      "enabled": true
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "run_id": {
          "type": "keyword"
        },
        "workspace_id": {
          "type": "keyword"
        },
        "benchmark_id": {
          "type": "keyword"
        },
        "scenario_id": {
          "type": "keyword"
        },
        "item": {
          "type": "object",
          "enabled": false
        },
        "name": {
          "type": "text"
        },
        "tags": {
          "type": "keyword"
        },
        "split": {
          "type": "keyword"
        }
      }
    }
  }
}
