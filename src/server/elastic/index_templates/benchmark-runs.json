{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Benchmark Runs",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-benchmark-runs*"
  ],
  "template": {
    "settings": {
      "index": {
        "sort.field": "@meta.created_at",
        "sort.order": "desc"
      }
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@meta": {
          "properties": {
            "status": {
              "type": "keyword"
            },
            "created_at": {
              "type": "date"
            },
            "created_by": {
              "type": "keyword"
            },
            "created_via": {
              "type": "keyword"
            },
            "started_at": {
              "type": "date"
            },
            "started_by": {
              "type": "keyword"
            },
            "stopped_at": {
              "type": "date"
            }
          }
        },
        "workspace_id": {
          "type": "keyword"
        },
        "benchmark_id": {
          "type": "keyword"
        },
        "scenario_id": {
          "type": "keyword"
        },
        "strategy_id": {
          "type": "keyword"
        },
        "summary": {
          "type": "object",
          "enabled": false
        },
        "progress": {
          "properties": {
            "requests_total": {
              "type": "integer"
            },
            "requests_completed": {
              "type": "integer"
            },
            "requests_succeeded": {
              "type": "integer"
            },
            "requests_failed": {
              "type": "integer"
            }
          }
        },
        "task": {
          "properties": {
            "metrics": {
              "type": "keyword"
            },
            "k": {
              "type": "short"
            },
            "requests": {
              "type": "integer"
            },
            "strategies": {
              "properties": {
                "_ids": {
                  "type": "keyword"
                },
                "tags": {
                  "type": "keyword"
                },
                "docs": {
                  "type": "object",
                  "enabled": false
                }
              }
            },
            "scenarios": {
              "properties": {
                "_ids": {
                  "type": "keyword"
                },
                "tags": {
                  "type": "keyword"
                },
                "sample_size": {
                  "type": "integer"
                },
                "sample_seed": {
                  "type": "keyword"
                }
              }
            },
            "optimization": {
              "properties": {
                "algorithm": {
                  "type": "keyword"
                },
                "sample_size": {
                  "type": "integer"
                },
                "seed": {
                  "type": "keyword"
                },
                "points_per_range": {
                  "type": "integer"
                },
                "values_to_test": {
                  "type": "object",
                  "enabled": false
                },
                "objective": {
                  "properties": {
                    "metric": {
                      "type": "keyword"
                    },
                    "aggregation": {
                      "type": "keyword"
                    }
                  }
                },
                "latency_constraint": {
                  "properties": {
                    "stat": {
                      "type": "keyword"
                    },
                    "max_ms": {
                      "type": "float"
                    }
                  }
                },
                "holdout": {
                  "properties": {
                    "ratio": {
                      "type": "float"
                    },
                    "seed": {
                      "type": "keyword"
                    }
                  }
                },
                "max_concurrent_searches": {
                  "type": "integer"
                },
                "store_hits_top_n": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "error": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            },
            "traceback": {
              "type": "text"
            }
          }
        },
        "took": {
          "type": "integer"
        }
      }
    }
  }
}
