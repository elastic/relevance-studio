{
  "_meta": {
    "description": "Elasticsearch Relevance Studio - Benchmark Unrated Docs (data stream)",
    "version": "2.0.0"
  },
  "index_patterns": [
    "esrs-benchmark-unrated-docs*"
  ],
  "priority": 500,
  "data_stream": {},
  "template": {
    "lifecycle": {
      "enabled": true
    },
    "mappings": {
      "dynamic": "true",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "run_id": {
          "type": "keyword"
        },
        "workspace_id": {
          "type": "keyword"
        },
        "benchmark_id": {
          "type": "keyword"
        },
        "doc_id": {
          "type": "keyword"
        },
        "doc_index": {
          "type": "keyword"
        },
        "count": {
          "type": "integer"
        },
        "strategies": {
          "type": "keyword"
        },
        "scenarios": {
          "type": "keyword"
        }
      }
    }
  }
}
